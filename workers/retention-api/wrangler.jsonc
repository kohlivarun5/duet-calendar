{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duet-retention-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "env": {
    "sandbox": {
      "name": "duet-retention-api-sandbox",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "Sandbox",
        "RETENTION_CAMPAIGN_JSON": "{\"id\":\"shared-monthly-first-month-v1\",\"enabled\":false}"
      },
      "durable_objects": {
        "bindings": [{ "name": "RETENTION_LEDGER", "class_name": "RetentionLedger" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RetentionLedger"] }]
    },
    "production": {
      "name": "duet-retention-api",
      "workers_dev": false,
      "routes": [{ "pattern": "api.duetcalendar.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "Production",
        "RETENTION_CAMPAIGN_JSON": "{\"id\":\"shared-monthly-first-month-v1\",\"enabled\":false}"
      },
      "durable_objects": {
        "bindings": [{ "name": "RETENTION_LEDGER", "class_name": "RetentionLedger" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RetentionLedger"] }]
    }
  }
}
